<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="6DOF_URDF_macro">

  <xacro:macro name="assembly_6DOF_URDF" params="prefix">

    <!-- Links -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0.000000 0.000000 -0.031884" rpy="0 0 0"/>
        <mass value="0.596687"/>
        <inertia ixx="8.608796e-04" ixy="0.000000e+00" ixz="0.000000e+00"
                 iyy="8.608778e-04" iyz="0.000000e+00" izz="1.231935e-03"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/base_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="PETG_15_Gyroid"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/base_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Shoulder">
      <inertial>
        <origin xyz="-0.000095 -0.008184 0.098482" rpy="0 0 0"/>
        <mass value="2.094136"/>
        <inertia ixx="2.587229e-02" ixy="5.786696e-03" ixz="7.038970e-04"
                 iyy="4.623819e-03" iyz="-1.651409e-03" izz="2.818176e-02"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.086342"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Shoulder.dae" scale="1 1 1"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.086342"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Shoulder_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}UA">
      <inertial>
        <origin xyz="0.070469 0.078205 -0.113480" rpy="0 0 0"/>
        <mass value="1.236306"/>
        <inertia ixx="4.958228e-03" ixy="-2.087939e-03" ixz="-1.318650e-07"
                 iyy="4.306581e-03" iyz="-2.819097e-05" izz="4.648503e-03"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 -0.698132"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/UA.dae" scale="1 1 1"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 -0.698132"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/UA_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Elbow">
      <inertial>
        <origin xyz="-0.015531 0.020790 -0.069395" rpy="0 0 0"/>
        <mass value="0.733476"/>
        <inertia ixx="1.328959e-03" ixy="4.778990e-04" ixz="-2.397529e-05"
                 iyy="7.168999e-04" iyz="3.209492e-05" izz="1.533380e-03"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 -0.698132"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Elbow.dae" scale="1 1 1"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 -0.698132"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Elbow_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Roll">
      <inertial>
        <origin xyz="-0.001708 -0.009290 0.127780" rpy="0 0 0"/>
        <mass value="0.682370"/>
        <inertia ixx="1.825964e-03" ixy="-6.698787e-05" ixz="-2.868309e-05"
                 iyy="1.445666e-03" iyz="-1.542829e-04" izz="6.361788e-04"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="3.141593 0.000000 -0.214197"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Roll.dae" scale="1 1 1"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="3.141593 0.000000 -0.214197"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Roll_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Yaw">
      <inertial>
        <origin xyz="-0.015546 -0.012336 0.050500" rpy="0 0 0"/>
        <mass value="0.259842"/>
        <inertia ixx="1.293116e-04" ixy="-3.743600e-05" ixz="-3.755642e-12"
                 iyy="1.422665e-04" iyz="1.808699e-10" izz="1.729664e-04"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="-3.141593 0.000000 -0.412197"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Yaw.dae" scale="1 1 1"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="-3.141593 0.000000 -0.412197"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Yaw_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Gripper">
      <inertial>
        <origin xyz="0.000000 0.000000 -0.014692" rpy="0 0 0"/>
        <mass value="0.011203"/>
        <inertia ixx="1.935595e-06" ixy="0.000000e+00" ixz="0.000000e+00"
                 iyy="1.935595e-06" iyz="0.000000e+00" izz="1.864791e-06"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 -0.607892"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Gripper.dae" scale="1 1 1"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 -0.607892"/>
        <geometry>
          <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Gripper_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <!-- Joints (internal to assembly) -->
    <joint name="${prefix}Revolute_5" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}Shoulder"/>
      <origin xyz="0.000000 0.000000 -0.051500" rpy="0.000000 0.000000 0.000000"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="0.000000" upper="6.283185" effort="100.0" velocity="1.00"/>
    </joint>

    <joint name="${prefix}Revolute_13" type="revolute">
      <parent link="${prefix}Shoulder"/>
      <child link="${prefix}UA"/>
      <origin xyz="-0.007100 -0.149900 0.111900" rpy="1.570796 0.000000 0.086342"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="0.000000" upper="6.283185" effort="100.0" velocity="1.00"/>
    </joint>

    <joint name="${prefix}Revolute_29" type="revolute">
      <parent link="${prefix}UA"/>
      <child link="${prefix}Elbow"/>
      <origin xyz="0.133252 0.154914 -0.036000" rpy="0.000000 0.000000 0.000000"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="0.000000" upper="6.283185" effort="100.0" velocity="1.00"/>
    </joint>

    <joint name="${prefix}Revolute_37" type="revolute">
      <parent link="${prefix}Elbow"/>
      <child link="${prefix}Roll"/>
      <origin xyz="-0.015463 0.083655 -0.071500" rpy="1.570796 -0.214197 -1.161568"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="0.000000" upper="6.283185" effort="100.0" velocity="1.00"/>
    </joint>

    <joint name="${prefix}Revolute_43" type="revolute">
      <parent link="${prefix}Roll"/>
      <child link="${prefix}Yaw"/>
      <origin xyz="0.008683 0.049748 0.186000" rpy="1.570796 1.158599 -0.289463"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="0.000000" upper="6.283185" effort="100.0" velocity="1.00"/>
    </joint>

    <joint name="${prefix}Revolute_46" type="continuous">
      <parent link="${prefix}Yaw"/>
      <child link="${prefix}Gripper"/>
      <origin xyz="-0.055454 -0.045134 0.050500" rpy="1.570796 0.110328 -0.887634"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit effort="100.0" velocity="1.00"/>
    </joint>

    <!-- ROS 2 control: generated generic system -->
    <ros2_control name="${prefix}6DOF_URDF_system" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="cmd_topic">sim/6DOF_URDF_system/cmd</param>
        <param name="state_topic">sim/6DOF_URDF_system/state</param>
      </hardware>

      <joint name="${prefix}Revolute_13">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}Revolute_29">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}Revolute_37">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}Revolute_43">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}Revolute_46">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}Revolute_5">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>