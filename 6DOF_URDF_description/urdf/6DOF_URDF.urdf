        <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/20mm_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="Revolute_5" type="revolute">
    <parent link="base_link"/>
    <child link="Base_Motor"/>
    <origin xyz="-0.048850 0.117229 0.068000" rpy="0.000000 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="0.000000" upper="6.283185" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="Revolute_13" type="revolute">
    <parent link="Base_Motor"/>
    <child link="UA_Motor"/>
    <origin xyz="0.076040 -0.153400 -0.055062" rpy="-1.570796 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="0.000000" upper="6.283185" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="Rigid_25" type="fixed">
    <parent link="UA_Motor"/>
    <child link="Elbow_Connector_Passive"/>
    <origin xyz="-0.140442 -0.202376 0.018900" rpy="0.000000 0.000000 -0.698132"/>
  </joint>

  <joint name="Revolute_37" type="revolute">
    <parent link="Elbow_Connector_Passive"/>
    <child link="Roll_Housing"/>
    <origin xyz="0.106612 0.079606 -0.186510" rpy="-1.570796 0.000000 -0.610865"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="0.000000" upper="6.283185" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="Revolute_43" type="revolute">
    <parent link="Roll_Housing"/>
    <child link="20mm"/>
    <origin xyz="0.251183 -0.314427 0.170791" rpy="1.570796 -1.308997 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="0.000000" upper="6.283185" effort="100.0" velocity="1.00"/>
  </joint>

  <!-- ROS 2 control: generated generic system -->
  <ros2_control name="6DOF_URDF_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="cmd_topic">sim/6DOF_URDF_system/cmd</param>
      <param name="state_topic">sim/6DOF_URDF_system/state</param>
    </hardware>

    <joint name="Revolute_13">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="Revolute_37">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="Revolute_43">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="Revolute_5">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>