<?xml version="1.0"?>
<robot name="6DOF_URDF">

  <!-- Materials -->
  <material name="PETG_15_Gyroid">
    <color rgba="0.098 0.098 0.098 1.0"/>
  </material>
  <material name="Steel">
    <color rgba="1.000 1.000 1.000 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.000000 0.000000 -0.031604" rpy="0 0 0"/>
      <mass value="0.601590"/>
      <inertia ixx="8.670932e-04" ixy="0.000000e+00" ixz="0.000000e+00"
               iyy="8.670932e-04" iyz="0.000000e+00" izz="1.232945e-03"/>
    </inertial>
    <visual>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <geometry>
        <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/base_link.dae" scale="1 1 1"/>
      </geometry>
      <material name="PETG_15_Gyroid"/>
    </visual>
    <collision>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <geometry>
        <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/base_link_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <link name="Base_Motor">
    <inertial>
      <origin xyz="0.049697 -0.108760 -0.020987" rpy="0 0 0"/>
      <mass value="2.098842"/>
      <inertia ixx="2.679976e-02" ixy="3.861349e-03" ixz="-5.600426e-04"
               iyy="3.790863e-03" iyz="1.696564e-03" izz="2.827367e-02"/>
    </inertial>
    <visual>
      <origin xyz="0.000000 0.000000 -0.000600" rpy="3.141593 0.000000 0.000000"/>
      <geometry>
        <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Base_Motor.dae" scale="1 1 1"/>
      </geometry>
      <material name="Steel"/>
    </visual>
    <collision>
      <origin xyz="0.000000 0.000000 -0.000600" rpy="3.141593 0.000000 0.000000"/>
      <geometry>
        <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Base_Motor_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <link name="UA_Motor">
    <inertial>
      <origin xyz="-0.081949 -0.130878 0.071799" rpy="0 0 0"/>
      <mass value="1.315683"/>
      <inertia ixx="5.586235e-03" ixy="-2.437625e-03" ixz="1.020418e-04"
               iyy="4.787916e-03" iyz="1.483998e-04" izz="5.396456e-03"/>
    </inertial>
    <visual>
      <origin xyz="-0.077066 -0.122959 0.060400" rpy="-3.141593 0.000000 2.443461"/>
      <geometry>
        <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/UA_Motor.dae" scale="1 1 1"/>
      </geometry>
      <material name="Steel"/>
    </visual>
    <collision>
      <origin xyz="-0.077066 -0.122959 0.060400" rpy="-3.141593 0.000000 2.443461"/>
      <geometry>
        <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/UA_Motor_collision.stl" scale="0.01 0.01 0.01"/>
