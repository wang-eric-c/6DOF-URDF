  <link name="20mm">
    <inertial>
      <origin xyz="-0.160624 0.152440 -0.069417" rpy="0 0 0"/>
      <mass value="0.318715"/>
      <inertia ixx="1.638087e-04" ixy="5.662339e-05" ixz="-3.202578e-11"
               iyy="1.870873e-04" iyz="-1.709404e-10" izz="2.324443e-04"/>
