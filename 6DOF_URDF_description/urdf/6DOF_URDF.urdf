  </link>

  <link name="Roll_Housing">
    <inertial>
      <origin xyz="0.041154 -0.253297 -0.010541" rpy="0 0 0"/>
      <mass value="0.777648"/>
      <inertia ixx="2.292696e-03" ixy="1.323394e-06" ixz="-2.147043e-06"
               iyy="1.753582e-03" iyz="-2.028961e-04" izz="8.080313e-04"/>
    </inertial>
    <visual>
      <origin xyz="0.041229 -0.283510 -0.047460" rpy="-1.570796 1.570796 0.000000"/>
      <geometry>
        <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Roll_Housing.dae" scale="1 1 1"/>
      </geometry>
      <material name="Steel"/>
    </visual>
    <collision>
      <origin xyz="0.041229 -0.283510 -0.047460" rpy="-1.570796 1.570796 0.000000"/>
      <geometry>
        <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Roll_Housing_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
