    </inertial>
    <visual>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <geometry>
        <mesh filename="package://6DOF_URDF_description/meshes/6DOF_URDF/Elbow_Connector_Passive.dae" scale="1 1 1"/>
